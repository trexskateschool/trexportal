<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Logo Resmi - TREX Skate School</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background-color: #0f172a;
      font-family: system-ui, -apple-system, sans-serif;
      color: #f8fafc;
      padding: 24px;
    }

    .logo-wrapper {
      width: 100%;
      max-width: 340px;
      aspect-ratio: 1 / 1;
      display: flex;
      align-items: center;
      justify-content: center;
      filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.45));
    }

    .logo-wrapper svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    .caption {
      margin-top: 20px;
      text-align: center;
      font-size: 13px;
      color: #94a3b8;
      letter-spacing: 0.05em;
    }
  </style>
</head>
<body>

  <div class="logo-wrapper">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="500" height="500">
      <defs>
        <clipPath id="emblemCircle">
          <circle cx="250" cy="230" r="137" />
        </clipPath>
      </defs>

      <!-- Lingkaran Putih Dasar -->
      <circle cx="250" cy="250" r="245" fill="#FFFFFF" />

      <!-- Bingkai Luar Emblem (Hitam - Emas - Hitam - Merah) -->
      <circle cx="250" cy="230" r="162" fill="#111111" />
      <circle cx="250" cy="230" r="156" fill="#E8B938" />
      <circle cx="250" cy="230" r="143" fill="#111111" />
      <circle cx="250" cy="230" r="137" fill="#E5391A" />

      <!-- Isi di Dalam Lingkaran Merah -->
      <g clip-path="url(#emblemCircle)">
        <!-- Siluet Pixel T-Rex -->
        <g fill="#111111">
          <!-- Kepala T-Rex -->
          <rect x="206" y="108" width="68" height="11" />
          <rect x="194" y="119" width="92" height="12" />
          <rect x="188" y="131" width="104" height="40" />
          <!-- Rahang & Celah Mulut -->
          <rect x="188" y="171" width="48" height="12" />
          <rect x="188" y="183" width="84" height="11" />

          <!-- Leher & Tangga Punggung / Ekor -->
          <rect x="176" y="194" width="62" height="13" />
          <rect x="162" y="207" width="76" height="13" />
          <rect x="148" y="220" width="90" height="13" />
          <rect x="134" y="233" width="104" height="15" />
          <rect x="120" y="248" width="118" height="16" />

          <!-- Tangan Kecil T-Rex -->
          <rect x="238" y="214" width="24" height="10" />
          <rect x="252" y="224" width="10" height="10" />
        </g>

        <!-- Dua Kaktus Pixel di Sisi Kanan -->
        <g fill="#111111">
          <!-- Kaktus Kiri -->
          <rect x="301" y="212" width="9" height="52" />
          <rect x="290" y="228" width="11" height="9" />
          <rect x="290" y="218" width="6" height="12" />
          <rect x="310" y="224" width="10" height="9" />
          <rect x="314" y="214" width="6" height="12" />

          <!-- Kaktus Kanan -->
          <rect x="331" y="198" width="10" height="66" />
          <rect x="320" y="218" width="11" height="9" />
          <rect x="320" y="206" width="6" height="14" />
          <rect x="341" y="214" width="11" height="9" />
          <rect x="346" y="202" width="6" height="14" />
        </g>

        <!-- Kaki & Sepatu Roda T-Rex di Bawah Spanduk -->
        <g fill="#111111">
          <!-- Kaki & Sepatu Roda Kiri -->
          <rect x="210" y="330" width="12" height="14" />
          <rect x="210" y="344" width="26" height="7" />
          <rect x="210" y="353" width="4" height="5" />
          <rect x="217" y="353" width="4" height="5" />
          <rect x="224" y="353" width="4" height="5" />
          <rect x="231" y="353" width="4" height="5" />

          <!-- Kaki & Sepatu Roda Kanan -->
          <rect x="248" y="330" width="12" height="14" />
          <rect x="248" y="344" width="26" height="7" />
          <rect x="248" y="353" width="4" height="5" />
          <rect x="255" y="353" width="4" height="5" />
          <rect x="262" y="353" width="4" height="5" />
          <rect x="269" y="353" width="4" height="5" />
        </g>
      </g>

      <!-- Spanduk Utama TREX SKATE SCHOOL -->
      <rect x="84" y="262" width="332" height="68" fill="#111111" />
      <rect x="89" y="267" width="322" height="58" fill="#E8B938" />
      <rect x="96" y="274" width="308" height="44" fill="#111111" />

      <!-- Bayangan Teks Merah -->
      <text
        x="252"
        y="310"
        text-anchor="middle"
        textLength="286"
        lengthAdjust="spacingAndGlyphs"
        font-family="Impact, 'Arial Narrow', sans-serif"
        font-weight="900"
        font-size="35"
        fill="#E5391A"
      >
        TREX SKATE SCHOOL
      </text>

      <!-- Teks Utama Putih -->
      <text
        x="250"
        y="308"
        text-anchor="middle"
        textLength="286"
        lengthAdjust="spacingAndGlyphs"
        font-family="Impact, 'Arial Narrow', sans-serif"
        font-weight="900"
        font-size="35"
        fill="#FFFFFF"
      >
        TREX SKATE SCHOOL
      </text>
    </svg>
  </div>

  <p class="caption">TREX SKATE SCHOOL • OFFICIAL VECTOR LOGO</p>

</body>
</html>
